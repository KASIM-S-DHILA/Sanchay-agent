{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanchay",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanchay-db",
      "database_id": "3ca05b11-abd8-47a5-9f9d-a2906d93f5b2"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "sanchay-catalog"
    }
  ],
  "observability": {
    "enabled": true
  }
}
