{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanchay",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.yaml"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanchay-db",
      "database_id": "3ca05b11-abd8-47a5-9f9d-a2906d93f5b2"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "sanchay-catalog"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret config. MERCHANT_MAX_ORDER_PAISE caps any single order
  // regardless of session/caller-declared budget (see checkoutCart in
  // src/api/logic.ts) — falls back to a hardcoded default if omitted.
  // ADMIN_TOKEN gates /admin/* and /api/audit — set via
  // `wrangler secret put ADMIN_TOKEN` in production; if unset those
  // endpoints reject every request (see middleware/adminAuth.ts).
  "vars": {
    "MERCHANT_MAX_ORDER_PAISE": "5000000"
  }
}
