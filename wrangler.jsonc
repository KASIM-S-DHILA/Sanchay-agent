{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanchay",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/index.ts",
  // Keep the workers.dev URL alive — Wrangler disables it by default the
  // moment any custom route/domain is configured below, which would have
  // silently broken the site's existing, already-working address.
  "workers_dev": true,
  // Serves the Worker on sanchay.store in addition to the workers.dev
  // subdomain. custom_domain:true provisions the DNS record + TLS cert
  // automatically since the zone is already on Cloudflare — but only once
  // any pre-existing A/AAAA/CNAME records for the hostname are removed
  // (Cloudflare refuses to override externally-managed DNS records).
  "routes": [
    {
      "pattern": "sanchay.store",
      "custom_domain": true
    },
    {
      "pattern": "www.sanchay.store",
      "custom_domain": true
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.yaml"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanchay-db",
      "database_id": "3ca05b11-abd8-47a5-9f9d-a2906d93f5b2"
    }
  ],
  // One SessionHub instance per session (see getByName(sessionId) at every
  // call site) — holds that session's live WebSocket connection(s) and
  // pushes a "something changed" signal after cart/checkout/webhook
  // mutations, replacing the 3s call-gated polling this session's
  // hardening work built (see useAuditFeed.ts / App.tsx's pollingActive)
  // with an event-driven push. Deliberately dumb: no D1 access, no
  // business logic — see src/durable/SessionHub.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_HUB",
        "class_name": "SessionHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionHub"
      ]
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "sanchay-catalog"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Drives the visual-description backfill (see catalog/visualDescribe.ts
  // and the scheduled() handler in src/index.ts) — runs once a minute,
  // completely decoupled from any HTTP request's lifetime. This exists
  // because ctx.waitUntil turned out to have a real ceiling that a
  // request-triggered background job could hit mid-catalog (confirmed
  // live: "waitUntil() tasks did not complete within the allowed time...
  // and have been cancelled" after processing only part of a 20-product
  // catalog). A cron trigger has no such coupling to a request/response —
  // it just wakes up, processes one small batch of whatever still needs a
  // description, and goes back to sleep; naturally resumes on its own the
  // next minute if there's more to do, and naturally covers newly-added
  // products too since it's always polling the same WHERE
  // visual_description IS NULL backlog seedCatalog/replaceCatalog feed
  // into.
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  // OTP sign-in emails go through Resend's REST API (see sendOtpEmail in
  // src/api/auth.ts) rather than Cloudflare Email Sending, which requires
  // a paid zone plan. RESEND_API_KEY is a secret (wrangler secret put),
  // no binding needed here.
  // Non-secret config. MERCHANT_MAX_ORDER_PAISE caps any single order
  // regardless of session/caller-declared budget (see checkoutCart in
  // src/api/logic.ts) — falls back to a hardcoded default if omitted.
  // ADMIN_TOKEN gates /admin/* only — set via `wrangler secret put
  // ADMIN_TOKEN` in production; if unset those endpoints reject every
  // request (see middleware/adminAuth.ts). /api/audit is gated
  // separately, by the caller's own validated session (see api/audit.ts).
  "vars": {
    "MERCHANT_MAX_ORDER_PAISE": "5000000"
  }
}
